{
    "name": "digitalcz/coding-standard",
    "description": "Coding standards used across projects developed by Digital Solutions teams.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codesniffer",
        "codestyle",
        "php"
    ],
    "require": {
        "php": ">=7.4",
        "slevomat/coding-standard": "8.19.*",
        "squizlabs/php_codesniffer": "3.13.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    }
}